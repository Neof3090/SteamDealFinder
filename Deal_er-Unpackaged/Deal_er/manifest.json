{
  "manifest_version": 3,
  "name": "Deal-er",
  "version": "0.1.3",
  "description": "Very simple and lightweight extension for finding the best Steam-redeemable deals with simple filters",

  "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "Icons/icon16.png",
        "32": "Icons/icon32.png",
        "48": "Icons/icon48.png",
       "128": "Icons/icon128.png"
      }
  },

  "icons": {
      "16": "Icons/icon16.png",
      "32": "Icons/icon32.png",
      "48": "Icons/icon48.png",
      "128": "Icons/icon128.png"
  },

  "background": {
      "service_worker": "background.js" 
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.cheapshark.com/*"
  ]
}
